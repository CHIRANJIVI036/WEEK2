#include <iostream>
using namespace std;

int main() {
    int marks[100], n = 0, choice;
    while (true) {
        cout << "\n1.Enter\n2.Average\n3.Highest/Lowest\n4.Exit\n";
        cin >> choice;
        if (choice == 1) {
            cin >> n;
            for (int i = 0; i < n; i++) cin >> marks[i];
        } else if (choice == 2) {
            int sum = 0;
            for (int i = 0; i < n; i++) sum += marks[i];
            cout << "Average: " << (float)sum / n << endl;
        } else if (choice == 3) {
            int high = marks[0], low = marks[0];
            for (int i = 1; i < n; i++) {
                if (marks[i] > high) high = marks[i];
                if (marks[i] < low) low = marks[i];
            }
            cout << "Highest: " << high << ", Lowest: " << low << endl;
        } else if (choice == 4) {
            break;
        }
    }
    return 0;
}
